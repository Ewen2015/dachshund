{
  "name": "dachshund",
  "version": "0.1.21",
  "description": "All your agents. One memory.",
  "main": "./out/main/index.js",
  "author": "Ewen Wang",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-mcp.mjs && node scripts/make-icons.mjs && node scripts/build-status-helper.mjs && electron-vite dev",
    "icons:agents": "node scripts/fetch-agent-icons.mjs",
    "build": "node scripts/fetch-agent-icons.mjs && node scripts/make-icons.mjs && node scripts/build-status-helper.mjs && electron-vite build && node scripts/build-mcp.mjs",
    "status-item:build": "node scripts/build-status-helper.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:panel": "node --experimental-strip-types scripts/test-panel-placement.mjs",
    "test:sync": "esbuild scripts/test-sync.ts --bundle --platform=node --format=cjs --outfile=out/test-sync.cjs && node out/test-sync.cjs",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64",
    "mcp": "node out/mcp/index.cjs",
    "test:agents": "node scripts/test-agents.mjs",
    "test:mcp": "node scripts/test-integration.mjs",
    "demo:seed": "node scripts/seed-demo.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "gray-matter": "^4.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.58.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "build": {
    "appId": "com.ewen.dachshund",
    "productName": "dachshund",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out/mcp",
        "to": "mcp"
      },
      {
        "from": "resources/bin/DachshundStatus.app",
        "to": "status-item/DachshundStatus.app"
      },
      {
        "from": "resources",
        "to": "assets",
        "filter": [
          "icon.png",
          "trayTemplate.png",
          "trayTemplate@2x.png",
          "trayTemplateLarge.png",
          "trayTemplateLarge@2x.png"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "extendInfo": {
        "LSUIElement": true
      },
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "dachshund",
      "contents": [
        {
          "x": 140,
          "y": 220
        },
        {
          "x": 400,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
